# Fernet key for encrypting saved connection credentials at rest.
# If unset, one is auto-generated into data/secret.key on first run.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# LLM provider API keys -- entirely optional here. These are only a fallback:
# keys can also be set from the app's Settings page (encrypted in the database),
# which takes precedence over whatever is set here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LiteLLM: used for local models, other vendors, or a self-hosted LiteLLM proxy
LITELLM_API_KEY=
LITELLM_API_BASE=

# SQLite database path
DATABASE_URL=sqlite:///./data/app.db

# Sandbox execution limits
EXECUTION_TIMEOUT_SECONDS=15
EXECUTION_MAX_ROWS=50000
